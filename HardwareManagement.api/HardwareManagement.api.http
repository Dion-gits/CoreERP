@HardwareManagement.api_HostAddress = http://localhost:5218

GET {{HardwareManagement.api_HostAddress}}/weatherforecast/
Accept: application/json

###

# 1. Master ERP: Create Company
POST {{HardwareManagement.api_HostAddress}}/companies
Content-Type: application/json

{
  "companyCode": "COMP001",
  "companyName": "Builders’ Hub",
  "isActive": true,
  "createdAt": "2026-09-03T09:15:00"
}

###

# 2. Master ERP: Create Device
POST {{HardwareManagement.api_HostAddress}}/devices
Content-Type: application/json

{
  "companyId": 1,
  "deviceCode": "DEV001",
  "deviceName": "Main PC",
  "isActive": true,
  "createdAt": "2026-09-03T09:50:00"
}

###

# 3. Master ERP: Map Company Database
POST {{HardwareManagement.api_HostAddress}}/company-databases
Content-Type: application/json

{
  "companyId": 1,
  "serverName": "db66559.public.databaseasp.net",
  "databaseName": "db66559",
  "isActive": true
}


